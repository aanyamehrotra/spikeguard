{
  "uid": "spikeguard-overview",
  "title": "SpikeGuard \u00b7 Replay overview",
  "description": "Replay completion and first-token latency by tier, gateway capacity and native model saturation.",
  "schemaVersion": 39,
  "version": 4,
  "editable": false,
  "tags": [
    "spikeguard"
  ],
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Native model saturation",
      "description": "Requests processing and waiting in llama.cpp. Available when the native model exports metrics.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "llamacpp:requests_deferred{job=\"llama\"}",
          "legendFormat": "Deferred requests",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "llamacpp:requests_processing{job=\"llama\"}",
          "legendFormat": "Processing requests",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Client p95 TTFT",
      "description": "Rolling histogram estimate for completed streams by arrival phase. The red line marks the draft 2 s target.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (phase, le) (rate(spikeguard_replay_ttft_seconds_bucket[12s])))",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^baseline( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^spike( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^recovery( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Offered and completed throughput",
      "description": "Dispatch and completion events per second by arrival phase. Completions can occur after the arrival phase ends.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_offered_total[12s]))",
          "legendFormat": "{{phase}} offered",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_finished_total{outcome=\"completed\"}[12s]))",
          "legendFormat": "{{phase}} completed",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Replay outcomes",
      "description": "Every terminal outcome per second over the past 12 seconds, summed across arrival phases.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(spikeguard_replay_finished_total[12s]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Shed fraction",
      "description": "Share of terminal outcomes classified as intentional 429 shedding within each rolling window.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_finished_total{outcome=\"shed\"}[12s])) / (sum by (phase) (rate(spikeguard_replay_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^baseline( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^spike( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^recovery( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Error fraction",
      "description": "Share of terminal outcomes that failed, excluding intentional shedding. Use the final replay JSON for the SLO denominator of all offered requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_finished_total{outcome!~\"completed|shed\"}[12s])) / (sum by (phase) (rate(spikeguard_replay_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^baseline( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^spike( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^recovery( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Gateway activity by tier",
      "description": "Active and queued requests in each gateway lane. Enable paid reservations to classify a separate paid lane.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "spikeguard_gateway_tier_active{job=\"gateway\"}",
          "legendFormat": "{{tier}} active",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "spikeguard_gateway_tier_queue_depth{job=\"gateway\"}",
          "legendFormat": "{{tier}} waiting",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Client p95 TTFT by tier",
      "description": "Rolling estimate for completed streams by arrival phase and tier. The red line marks the 2 s SLO.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (phase, tier, le) (rate(spikeguard_replay_tier_ttft_seconds_bucket[12s])))",
          "legendFormat": "{{phase}} {{tier}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Shed fraction by tier",
      "description": "Intentional 429s as a share of terminal outcomes for each phase and tier.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase, tier) (rate(spikeguard_replay_tier_finished_total{outcome=\"shed\"}[12s])) / (sum by (phase, tier) (rate(spikeguard_replay_tier_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}} {{tier}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Error fraction by tier",
      "description": "Unexpected errors as a share of terminal outcomes for each phase and tier.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase, tier) (rate(spikeguard_replay_tier_finished_total{outcome!~\"completed|shed\"}[12s])) / (sum by (phase, tier) (rate(spikeguard_replay_tier_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}} {{tier}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
