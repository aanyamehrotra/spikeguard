          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Gateway concurrency and active slots",
      "description": "Current admission target against active upstream requests. When the target falls, accepted work drains without being interrupted, and paid slots stay reserved.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "spikeguard_gateway_active{job=\"gateway\"}",
          "legendFormat": "Active upstream slots",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "spikeguard_gateway_concurrency_limit{job=\"gateway\"}",
          "legendFormat": "Admission target",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Gateway p95 timing by tier",
      "description": "Queue wait for admitted requests and time to first content from the upstream model. Each series estimates its own distribution over 12 seconds.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (tier, le) (rate(spikeguard_gateway_queue_wait_seconds_bucket{job=\"gateway\"}[12s])))",
          "legendFormat": "{{tier}} queue wait",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (tier, le) (rate(spikeguard_gateway_upstream_ttft_seconds_bucket{job=\"gateway\"}[12s])))",
          "legendFormat": "{{tier}} upstream TTFT",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
