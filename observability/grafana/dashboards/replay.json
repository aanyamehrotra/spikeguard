        }
      }
    },
    {
      "id": 11,
      "title": "Completion fraction by tier",
      "description": "Successful completions as a share of terminal outcomes for each arrival phase and tier over 12 seconds. Use the replay JSON to check the SLO against all offered requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase, tier) (rate(spikeguard_replay_tier_finished_total{outcome=\"completed\"}[12s])) / (sum by (phase, tier) (rate(spikeguard_replay_tier_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}} {{tier}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
