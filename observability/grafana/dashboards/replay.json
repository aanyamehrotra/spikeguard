{
  "uid": "spikeguard-overview",
  "title": "SpikeGuard \u00b7 Replay overview",
  "description": "Native llama.cpp queue and client-observed streaming outcomes during a local replay.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "spikeguard"
  ],
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Queues and active requests",
      "description": "Gateway waiting and active requests alongside native llama.cpp deferred requests and processing slots.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "llamacpp:requests_deferred{job=\"llama\"}",
          "legendFormat": "Deferred queue",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "llamacpp:requests_processing{job=\"llama\"}",
          "legendFormat": "Active slots",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "expr": "spikeguard_gateway_queue_depth{job=\"gateway\"}",
          "legendFormat": "Gateway waiting",
          "range": true,
          "instant": false,
          "refId": "C"
        },
        {
          "expr": "spikeguard_gateway_active{job=\"gateway\"}",
          "legendFormat": "Gateway active",
          "range": true,
          "instant": false,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Client p95 TTFT",
      "description": "Rolling histogram estimate for completed streams by arrival phase. The red line marks the draft 2 s target.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (phase, le) (rate(spikeguard_replay_ttft_seconds_bucket[12s])))",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^baseline( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^spike( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^recovery( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Offered and completed throughput",
      "description": "Dispatch and completion events per second by arrival phase. Completions can occur after the arrival phase ends.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_offered_total[12s]))",
          "legendFormat": "{{phase}} offered",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_finished_total{outcome=\"completed\"}[12s]))",
          "legendFormat": "{{phase}} completed",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Replay outcomes",
      "description": "Every terminal outcome per second over the past 12 seconds, summed across arrival phases.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(spikeguard_replay_finished_total[12s]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Shed fraction",
      "description": "Share of terminal outcomes classified as intentional 429 shedding within each rolling window.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_finished_total{outcome=\"shed\"}[12s])) / (sum by (phase) (rate(spikeguard_replay_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^baseline( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^spike( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^recovery( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Error fraction",
      "description": "Share of terminal outcomes that failed, excluding intentional shedding. Use the final replay JSON for the SLO denominator of all offered requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "spikeguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (phase) (rate(spikeguard_replay_finished_total{outcome!~\"completed|shed\"}[12s])) / (sum by (phase) (rate(spikeguard_replay_finished_total[12s])) > 0)",
          "legendFormat": "{{phase}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^baseline( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^spike( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^recovery( |$)/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
